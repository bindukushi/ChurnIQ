# Copy to .env and fill in for local (non-docker) runs.
# Uvicorn/FastAPI reads these via os.getenv() — no extra library needed if you
# export them in your shell, or use `python-dotenv` / `docker compose --env-file`.

# Database (defaults to local SQLite if unset)
DATABASE_URL=postgresql+psycopg2://churn_user:churn_pass@localhost:5432/churn_db

# Redis (optional — reserved for future caching/Celery use)
REDIS_URL=redis://localhost:6379/0

# JWT signing secret — MUST be changed and kept secret in production
JWT_SECRET_KEY=change_this_to_a_long_random_string

# Optional: enables natural-language answers in the AI Assistant via OpenAI.
# Without this, the assistant still works using grounded template responses.
OPENAI_API_KEY=
